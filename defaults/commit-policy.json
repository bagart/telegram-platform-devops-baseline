{
    "$schema": "https://raw.githubusercontent.com/bagart/telegram-platform-devops-baseline/main/schemas/commit-policy.v1.json",
    "version": 1,
    "prefixes": [
        "feat",
        "fix",
        "refactor",
        "perf",
        "test",
        "docs",
        "build",
        "ci",
        "chore",
        "security"
    ],
    "scopes": "optional",
    "pattern": "/^(feat|fix|refactor|perf|test|docs|build|ci|chore|security)(\\([^)]+\\))?!?: \\S.+$/"
}