#!/usr/bin/env bash
# Pre-push hook: delegates to the shared pre-push gate.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
BASELINE_DIR="${BASELINE_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
export BASELINE_DIR

if [[ -f "$ROOT/cmd/git/prepush" ]]; then
  exec "$ROOT/cmd/git/prepush"
fi

FAILS=0

php "${BASELINE_DIR}/controls/lf-check.php" --all || FAILS=1
php "${BASELINE_DIR}/controls/secret-scan.php" --all || FAILS=1

if [[ -x "$ROOT/vendor/bin/pint" ]]; then
  echo "==> Pint"
  "$ROOT/vendor/bin/pint" --test || FAILS=1
fi

if [[ "$FAILS" -ne 0 ]]; then
  echo "ERROR: pre-push failed — fix the issues above (do not use --no-verify)" >&2
  exit 1
fi

exit 0
